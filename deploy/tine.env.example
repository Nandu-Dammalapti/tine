# Tine proxy configuration. Copy to deploy/tine.env and fill it in.
# deploy/tine.env holds credentials: never commit it.
#
# Every value below is a placeholder. Nothing here is a working key, model name or price.
#
# Format rules that hold for both "docker compose" and "docker run --env-file":
#   - one NAME=value per line, no quotes around the value, no spaces around "="
#   - JSON values on one line
#   - avoid "$" and " #" inside a value (compose treats them specially)

# --- Required ---------------------------------------------------------------

# JSON object: incoming proxy token -> tenant id. Clients send the token as
# "Authorization: Bearer <token>" (or x-api-key). Use a long random token per tenant.
# The proxy refuses to start without at least one entry. It cannot tell a placeholder
# from a real token: left as it is, the published value below is a working token.
TINE_TENANT_KEYS={"REPLACE_WITH_A_LONG_RANDOM_TOKEN":"example-tenant"}

# --- Providers: configure only the ones you use -----------------------------

# Your own provider key. Requests go out on this account. Also used by judge checks.
TINE_ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_KEY
# Exact name of the model every request goes to unless a policy says otherwise.
# When you change this, the example shadow policy below no longer names your frontier
# and the proxy refuses to start. Comment out TINE_CHECKS and TINE_SHADOW_POLICIES
# until you have a policy of your own.
TINE_ANTHROPIC_FRONTIER_MODEL=EXAMPLE-FRONTIER-MODEL
# API-compatible upstream. HTTP(S) URL without credentials. Default shown.
TINE_ANTHROPIC_BASE_URL=https://api.anthropic.com

# TINE_OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_KEY
# TINE_OPENAI_FRONTIER_MODEL=EXAMPLE-OPENAI-FRONTIER-MODEL
# Point this at an OpenAI-compatible server on your own hardware to keep that
# traffic inside your network. Default shown.
# TINE_OPENAI_BASE_URL=https://api.openai.com

# Upstream timeout in seconds. Default 30.
TINE_TIMEOUT_SECONDS=30

# --- Ledger -----------------------------------------------------------------

# SQLite file inside the container. /data is the mounted volume. Leave as is
# unless you also change the volume in docker-compose.yml.
TINE_LEDGER_PATH=/data/ledger.sqlite3

# "true" (default) reuses an answer only after its outcome was reported as a success.
TINE_VERIFIED_CACHE=true

# "1" (or "true") refuses to serve an answer the ledger could not record: the caller
# gets a 503 instead. Default off: the answer is served with x-tine-ledger: unavailable.
# TINE_LEDGER_REQUIRED=1

# JSON object: "provider:model" -> USD per million tokens. Keys allowed per model:
# input_per_million, output_per_million, cached_input_per_million, cache_write_per_million.
# Costs and savings are unknown for any model without a price, so list the frontier,
# every policy stage model and every judge model. The proxy refuses to start shadow
# sampling when a stage model or judge model of a shadow policy has no input and
# output price.
# THE NUMBERS BELOW ARE MADE UP. Replace them with your contract prices.
TINE_MODEL_PRICES={"anthropic:EXAMPLE-FRONTIER-MODEL":{"input_per_million":10.0,"output_per_million":50.0},"anthropic:EXAMPLE-MID-MODEL":{"input_per_million":2.0,"output_per_million":10.0},"anthropic:EXAMPLE-SMALL-MODEL-A":{"input_per_million":1.0,"output_per_million":5.0},"anthropic:EXAMPLE-SMALL-MODEL-B":{"input_per_million":1.0,"output_per_million":5.0},"anthropic:EXAMPLE-JUDGE-MODEL":{"input_per_million":2.0,"output_per_million":10.0}}

# Optional. JSON object: provider -> model names a client may ask for by name.
# A development switch, not a calibrated router. Leave unset for frontier-only.
# TINE_ALLOWED_MODELS={"anthropic":["EXAMPLE-MID-MODEL"]}

# --- Named checks -----------------------------------------------------------

# Path (inside the container) to the checks JSON. See deploy/checks.example.json.
# A webhook step sends the request and the cheaper model's response to the URL in
# that file. Point it only at your own infrastructure.
TINE_CHECKS=/config/checks.json
# Not read by the proxy directly: the example checks file names this variable in
# "bearer_env", and the proxy sends its value as a bearer token to your webhook.
CI_WEBHOOK_TOKEN=REPLACE_WITH_YOUR_WEBHOOK_TOKEN
# Optional. Path to a second checks JSON: tenant id -> check name -> steps, for checks
# that belong to one tenant. A tenant's own check wins over one of the same name in
# TINE_CHECKS, and no other tenant can use it. Needed when two tenants' policies name
# the same check and it has a webhook step: the proxy refuses to start otherwise.
# TINE_TENANT_CHECKS=/config/tenant-checks.json

# --- Shadow mode ------------------------------------------------------------

# Path (inside the container) to tenant -> provider -> frozen policy.
# See deploy/shadow-policies.example.json. The example policy is fake: replace it
# with one frozen from your own graded tasks before raising the sample rate.
TINE_SHADOW_POLICIES=/config/shadow-policies.json
# Share of eligible requests to shadow, 0 to 1. 0 means shadow mode is off.
TINE_SHADOW_SAMPLE_RATE=0
# Spending cap in USD per tenant for shadow calls. Required once the rate is above 0.
# It counts known costs only. The run in progress when the cap is crossed still completes.
TINE_SHADOW_MAX_COST_USD=5.00
# Shadow runs in flight at once, for the whole proxy. A sampled request that arrives
# while all are busy is not shadowed. Whole number, at least 1. Default 8.
# TINE_SHADOW_MAX_CONCURRENT=8
# How many shadow calls or checks of unknown cost a tenant may have before its
# shadowing stops. The cap above cannot count them in dollars. Whole number, 0 or more.
# Default 20.
# TINE_SHADOW_MAX_UNKNOWN_COST_CALLS=20
# Optional regular expression. A response's comparable answer is its last match
# (first group if there is one). Without it whole response texts are compared.
# TINE_ANSWER_PATTERN=Answer: ([A-D])

# --- Routing through a policy (changes what callers receive) ----------------

# Path to tenant -> provider -> frozen policy, same format as the shadow file.
# A tenant's provider can have a shadow policy or a route policy, never both.
# Run shadow mode first. Leave unset until you have read docs/PROXY.md.
# TINE_ROUTE_POLICIES=/config/route-policies.json
# "true" estimates the frontier baseline for a routed answer from the answer's
# token counts at the frontier's prices. It is an estimate, not a measurement.
# TINE_ROUTE_ESTIMATE_BASELINE=false
# Seconds a route policy's cheaper stages may take together for one request. When it
# runs out the request goes to the frontier. Default: TINE_TIMEOUT_SECONDS. Raise it
# to cover the test run when a stage's check runs tests.
# TINE_ROUTE_DEADLINE_SECONDS=30
